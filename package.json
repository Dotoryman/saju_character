{
  "name": "saju_character",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run cf-typegen && tsc -b && vite build",
    "typecheck": "npm run cf-typegen && tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply ganji-character-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ganji-character-db --remote"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "lunar-javascript": "^1.7.7",
    "vitest": "latest"
  }
}
